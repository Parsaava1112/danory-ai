{
  "model_config": "configs/model.json",
  "tokenizer_dir": "data/tokenizer",
  "train_data": "data/public/train.jsonl",
  "val_data": "data/public/validation.jsonl",
  "sft_data": "data/public/sft.jsonl",
  "out_dir": "checkpoints",
  "log_dir": "logs",
  "seed": 2028,
  "cpu_threads": 4,
  "batch_size": 1,
  "grad_accum": 4,
  "learning_rate": 0.0002,
  "min_lr": 0.00002,
  "weight_decay": 0.1,
  "betas": [0.9, 0.95],
  "adam_eps": 1e-8,
  "warmup_steps": 300,
  "max_steps": 6000,
  "eval_interval": 100,
  "eval_batches": 20,
  "save_interval": 100,
  "grad_clip": 1.0,
  "log_interval": 10,
  "shuffle_buffer": 256,
  "device": "auto"
}
